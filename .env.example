# Smartsheet API Configuration
SMARTSHEET_API_TOKEN=your_api_token_here

# PostgreSQL Database Configuration (optional - used for connection testing)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=your_database
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

# MySQL Database Configuration (optional - used for connection testing)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=your_database
MYSQL_USER=your_username
MYSQL_PASSWORD=your_password

# Optional: Alternative environment variable names
# SS_API_TOKEN=your_api_token_here
# DATABASE_URL=postgresql://user:password@host:port/database
# DATABASE_URL=mysql://user:password@host:port/database